# bexio-bot environment variables
# Copy this file to .env.local for local dev. NEVER commit .env files.

# ── Postgres ───────────────────────────────────────────────
# Local dev: docker-compose exposes Postgres on 5433
DATABASE_URL=postgres://bexiobot:dev-only-change-in-prod@localhost:5433/bexiobot
POSTGRES_PASSWORD=dev-only-change-in-prod

# ── bexio OAuth ────────────────────────────────────────────
# Get these from https://developer.bexio.com after creating the bot client
BEXIO_CLIENT_ID=
BEXIO_CLIENT_SECRET=
BEXIO_REDIRECT_URI=http://localhost:8080/callback
# Refresh token is filled in after the initial OAuth flow runs (Pre-Phase 0a step 2)
BEXIO_REFRESH_TOKEN=

# ── Discord ────────────────────────────────────────────────
# Webhook URL from Server Settings → Integrations → Webhooks → New Webhook
DISCORD_WEBHOOK_URL=

# ── Worker config ──────────────────────────────────────────
WORKER_TZ=Europe/Zurich
WORKER_DRY_RUN=false  # set to true to skip side-effects (no bexio writes, no Discord pings)
LOG_LEVEL=info

# ── Coolify (deploy target) ────────────────────────────────
# Get an API token from coolify → Keys & Tokens → API tokens
COOLIFY_BASE_URL=https://coolify.martini.digital
COOLIFY_API_TOKEN=
