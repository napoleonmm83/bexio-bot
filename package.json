{
  "name": "bexio-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "worker": "bun run apps/worker/src/cli.ts",
    "worker:dry": "WORKER_DRY_RUN=true bun run apps/worker/src/cli.ts",
    "oauth-setup": "bun run apps/worker/src/oauth-setup.ts",
    "test-bexio": "bun run apps/worker/src/test-bexio.ts",
    "test-discord": "bun run apps/worker/src/test-discord.ts",
    "db:generate": "bun run --cwd packages/db drizzle-kit generate",
    "db:migrate": "bun run packages/db/src/migrate.ts",
    "db:studio": "bun run --cwd packages/db drizzle-kit studio",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.6.3"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
